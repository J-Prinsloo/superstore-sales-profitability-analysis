    <worksheet name='Regional Discount Analysis'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='2'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Central&apos;s profitability is being disproportionately affected by 80% discounts.</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> Unlike the other regions, Central has sales at an 80% discount, exclusively across Binders and Appliances. These transactions generate approximately </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>$30k in losses</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> and contribute to Central&apos;s significantly lower overall profit margin of </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>8%</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>. </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Review or eliminate 80% discounts in Central</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>, particularly for Binders and Appliances, and assess whether lower discount levels could preserve sales while improving profitability.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='FactSales+ (SuperstoreDW)' name='federated.1tehzmq0pjhbvo16j8n1816jvp8y' />
          </datasources>
          <datasource-dependencies datasource='federated.1tehzmq0pjhbvo16j8n1816jvp8y'>
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column caption='Discount' datatype='real' default-format='p0%' name='[discount]' role='measure' type='quantitative' />
            <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
            <column-instance column='[discount]' derivation='None' name='[none:discount:ok]' pivot='key' type='ordinal' />
            <column caption='Profit' datatype='real' name='[profit]' role='measure' type='quantitative' />
            <column-instance column='[profit]' derivation='Sum' name='[sum:profit:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.1tehzmq0pjhbvo16j8n1816jvp8y].[none:Region:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.1tehzmq0pjhbvo16j8n1816jvp8y].[sum:profit:qk]</rows>
        <cols>[federated.1tehzmq0pjhbvo16j8n1816jvp8y].[none:discount:ok]</cols>
      </table>
      <simple-id uuid='{BA025AED-584C-4722-B5CB-26A83F9BCDD0}' />
    </worksheet>
