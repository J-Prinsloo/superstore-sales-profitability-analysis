      <zones>
        <zone h='39130' id='7' name='Regional Discount Analysis' w='35732' x='50544' y='15511' />
        <zone h='12456' id='8' name='Regional Discount Analysis' pane-specification-id='0' param='[federated.1tehzmq0pjhbvo16j8n1816jvp8y].[none:Region:nk]' type-v2='color' w='8464' x='88150' y='16686' />
        <zone h='34078' id='9' name='Central&apos;s Profit at 80% Discount' w='29323' x='7618' y='61340' />
        <zone h='8226' id='15' type-v2='text' w='33132' x='28779' y='3408'>
          <formatted-text>
